# ==========================================
# Configuración para Portainer Stack
# ==========================================

# Imágenes Docker
APP_IMAGE=cine-backend-nest:latest
NGINX_IMAGE=cine-nginx:latest

# Puertos
DB_PORT=5432
HTTP_PORT=80

# Replicas de API NestJS
API_REPLICAS=1

# Base de Datos PostgreSQL
DB_USERNAME=nodejs
DB_PASSWORD=123456
DB_NAME=postgres

# Seguridad & Autenticación (JWT)
JWT_ACCESS_SECRET=riwi_super_access_secret_2026
JWT_REFRESH_SECRET=riwi_super_refresh_secret_2026

# Cookies
COOKIE_DOMAIN=localhost
