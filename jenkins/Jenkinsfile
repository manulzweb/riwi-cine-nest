pipeline {

    agent any

    /*
     * ============================================================
     * PIPELINE AS CODE - RIWI CINE BACKEND (NESTJS)
     * ============================================================
     *
     * Arquitectura modular con encapsulamiento de la aplicación en /app/,
     * orquestación exterior de Jenkins, SonarQube, Nginx (load balancer)
     * y múltiples instancias escalables de la API NestJS.
     *
     * Flujo de Etapas:
     *
     *  1. Checkout Information ──▶ Metadatos del commit y rama
     *  2. Install Dependencies  ──▶ npm ci en /app/
     *  3. Lint                  ──▶ ESLint en /app/
     *  4. Unit Tests            ──▶ Pruebas Vitest en /app/
     *  5. Coverage              ──▶ Reporte LCOV (app/coverage/lcov.info)
     *  6. Build                 ──▶ Compilación NestJS (app/dist/main.js)
     *  7. SonarQube Analysis    ──▶ Escaneo SAST contra SonarQube
     *  8. Quality Gate          ──▶ Stop-the-line si no supera umbrales
     *  9. Docker Build          ──▶ Construcción imagen con app/Dockerfile
     * 10. Deploy                ──▶ Despliegue de DB, api-1, api-2 y Nginx
     * 11. Health Check          ──▶ Verificación balanceada (GET /health)
     */

    environment {

        /*
         * Nombre de la instancia SonarQube en Jenkins:
         * Jenkins -> Manage Jenkins -> System -> SonarQube servers
         */
        SONARQUBE_NAME = 'SonarQube'

        /*
         * Project Key y Nombre configurados en SonarQube
         */
        SONAR_PROJECT_KEY = 'riwi-cine-nest'
        SONAR_PROJECT_NAME = 'Cine-Backend-Nest'

        /*
         * Identificador y etiquetas de la imagen Docker de la API
         */
        DOCKER_IMAGE = 'cine-backend-nest'

        /*
         * Puerto HTTP expuesto por Nginx y ruta de Health Check
         */
        HTTP_PORT = "${env.HTTP_PORT ?: '80'}"
        APP_HEALTH_PATH = "${env.APP_HEALTH_PATH ?: '/health'}"

        /*
         * Parámetros para despliegue SSH (opcional, estilo example-jenkins)
         */
        SSH_CREDENTIAL_ID = 'deploy-server-ssh'
        DEPLOY_HOST = "${env.DEPLOY_HOST ?: 'app'}"
        DEPLOY_USER = "${env.DEPLOY_USER ?: 'deploy'}"
        DEPLOY_PATH = "${env.DEPLOY_PATH ?: '/opt/cine-backend-nest'}"
    }

    stages {

        /*
         * ========================================================
         * 1. CHECKOUT INFORMATION
         * ========================================================
         */
        stage('Checkout information') {

            steps {

                echo '''
                ==========================================
                 1. CHECKOUT INFORMATION
                ==========================================
                '''

                sh '''
                    set -e

                    echo "Repositorio:"
                    git remote get-url origin || true

                    echo ""
                    echo "Rama:"
                    git branch --show-current || echo "${GIT_BRANCH:-main}"

                    echo ""
                    echo "Último Commit:"
                    git log -1 --oneline || true

                    echo ""
                    echo "Autor y Fecha:"
                    git log -1 --format="Autor: %an <%ae>%nFecha: %ad" || true
                '''
            }
        }


        /*
         * ========================================================
         * 2. INSTALL DEPENDENCIES
         * ========================================================
         */
        stage('Install dependencies') {

            steps {

                echo '''
                ==========================================
                 2. INSTALL DEPENDENCIES (app/)
                ==========================================
                '''

                dir('app') {

                    sh '''
                        set -e

                        echo "Entorno Node.js en Jenkins:"
                        echo "Node : $(node --version)"
                        echo "NPM  : $(npm --version)"

                        echo ""
                        echo "Instalando dependencias en app/ con npm ci..."
                        npm ci

                        echo ""
                        echo "Dependencias instaladas exitosamente en app/."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 3. LINT
         * ========================================================
         */
        stage('Lint') {

            steps {

                echo '''
                ==========================================
                 3. LINT (app/ - ESLINT)
                ==========================================
                '''

                dir('app') {

                    sh '''
                        set -e

                        echo "Ejecutando ESLint en app/..."
                        npm run lint

                        echo ""
                        echo "Validación ESLint OK (0 errores)."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 4. UNIT TESTS
         * ========================================================
         */
        stage('Unit Tests') {

            steps {

                echo '''
                ==========================================
                 4. UNIT TESTS (app/ - VITEST)
                ==========================================
                '''

                dir('app') {

                    sh '''
                        set -e

                        echo "Ejecutando pruebas unitarias con Vitest en app/..."
                        npm test

                        echo ""
                        echo "Pruebas unitarias completadas satisfactoriamente."
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 5. COVERAGE
         * ========================================================
         */
        stage('Coverage') {

            steps {

                echo '''
                ==========================================
                 5. TEST COVERAGE (app/ - LCOV)
                ==========================================
                '''

                dir('app') {

                    sh '''
                        set -e

                        echo "Generando reporte de cobertura LCOV en app/..."
                        npm run test:cov

                        echo ""
                        echo "Validando reporte LCOV en app/coverage/lcov.info..."
                        if [ ! -f coverage/lcov.info ]; then
                            echo "ERROR: Reporte coverage/lcov.info no existe en app/."
                            exit 1
                        fi

                        echo "Reporte LCOV generado correctamente:"
                        ls -la coverage/lcov.info
                    '''
                }
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts: 'app/coverage/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }


        /*
         * ========================================================
         * 6. SONARQUBE ANALYSIS
         * ========================================================
         */
        stage('SonarQube Analysis') {

            steps {

                echo '''
                ==========================================
                 6. SONARQUBE ANALYSIS (SAST)
                ==========================================
                '''

                withSonarQubeEnv("${SONARQUBE_NAME}") {

                    dir('app') {

                        sh '''
                            set -e

                            SCANNER_BIN="sonar-scanner"
                            if ! command -v sonar-scanner >/dev/null 2>&1; then
                                if [ -f "./node_modules/.bin/sonar-scanner" ]; then
                                    SCANNER_BIN="./node_modules/.bin/sonar-scanner"
                                elif command -v npx >/dev/null 2>&1; then
                                    echo "sonar-scanner no detectado en PATH, ejecutando vía npx..."
                                    SCANNER_BIN="npx --yes sonarqube-scanner"
                                fi
                            fi

                            echo "Ejecutando escaneo con ${SCANNER_BIN} en app/..."
                            ${SCANNER_BIN} \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.projectName=${SONAR_PROJECT_NAME} \
                                -Dsonar.sources=src \
                                -Dsonar.tests=src,test \
                                -Dsonar.test.inclusions="src/**/*.spec.ts,test/**/*.spec.ts,test/**/*.e2e-spec.ts" \
                                -Dsonar.exclusions="src/**/*.spec.ts,test/**,**/node_modules/**,dist/**,coverage/**,src/database/migrations/**,src/database/seeders/**" \
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info

                            echo ""
                            echo "Análisis de SonarQube enviado exitosamente."
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 7. QUALITY GATE
         * ========================================================
         */
        stage('Quality Gate') {

            steps {

                echo '''
                ==========================================
                 7. QUALITY GATE (STOP-THE-LINE)
                ==========================================
                '''

                script {
                    try {
                        timeout(time: 3, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: true
                        }
                    } catch (Exception e) {
                        echo "waitForQualityGate falló o no tiene webhook configurado. Consultando API REST de SonarQube..."
                        sh '''
                            set -e
                            SONAR_URL="${SONARQUBE_URL:-http://sonarqube:9000}"
                            PROJECT_KEY="${SONAR_PROJECT_KEY:-riwi-cine-nest}"

                            echo "Consultando Quality Gate en la API de SonarQube: ${SONAR_URL}/api/qualitygates/project_status?projectKey=${PROJECT_KEY}"
                            sleep 5

                            STATUS=""
                            for i in $(seq 1 12); do
                                RESPONSE=$(curl -s "${SONAR_URL}/api/qualitygates/project_status?projectKey=${PROJECT_KEY}" || true)
                                STATUS=$(echo "${RESPONSE}" | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4 || true)
                                echo "Intento ${i}: Estado del Quality Gate = ${STATUS}"

                                if [ "${STATUS}" = "OK" ] || [ "${STATUS}" = "ERROR" ]; then
                                    break
                                fi
                                sleep 5
                            done

                            if [ "${STATUS}" = "OK" ]; then
                                echo "QUALITY GATE APROBADO (STATUS: OK)"
                            elif [ "${STATUS}" = "ERROR" ]; then
                                echo "[ERROR] QUALITY GATE RECHAZADO (STATUS: ERROR). Deteniendo pipeline."
                                exit 1
                            else
                                echo "Advertencia: No se obtuvo respuesta concluyente vía API, continuando."
                            fi
                        '''
                    }
                }
            }
        }


        /*
         * ========================================================
         * 8. BUILD
         * ========================================================
         */
        stage('Build') {

            steps {

                echo '''
                ==========================================
                 8. BUILD (app/ - NESTJS)
                ==========================================
                '''

                dir('app') {

                    sh '''
                        set -e

                        echo "Compilando NestJS con nest build..."
                        npm run build

                        echo ""
                        echo "Validando artefacto generado..."
                        if [ ! -f dist/main.js ]; then
                            echo "ERROR: No existe dist/main.js en app/ tras la compilación."
                            exit 1
                        fi

                        echo "Compilación exitosa (app/dist/main.js generado correctamente)."
                        ls -lh dist/main.js
                    '''
                }
            }
        }


        /*
         * ========================================================
         * 9. DEPLOY
         * ========================================================
         *
         * Despliegue de DB, migraciones, instancias de API y Nginx
         */
        stage('Deploy') {

            when {

                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'develop'
                    expression {
                        def branch = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                        return branch.contains('main') || branch.contains('master') || branch.contains('develop') || branch == ''
                    }
                }
            }

            steps {

                echo '''
                ==========================================
                 9. DEPLOY (DOCKER COMPOSE)
                ==========================================
                '''

                sh '''
                    set -e

                    echo "Verificando archivo de entorno (.env)..."
                    if [ ! -f .env ]; then
                        echo "Creando .env a partir de .env.example..."
                        cp .env.example .env
                    fi

                    COMPOSE_CMD="docker compose"
                    if ! docker compose version >/dev/null 2>&1; then
                        COMPOSE_CMD="docker-compose"
                    fi

                    echo "Deteniendo contenedores previos del backend y Nginx..."
                    ${COMPOSE_CMD} stop api nginx || true
                    ${COMPOSE_CMD} rm -f api nginx || true

                    echo ""
                    echo "Levantando PostgreSQL y ejecutando migraciones..."
                    ${COMPOSE_CMD} up -d postgres
                    ${COMPOSE_CMD} up migrate || true

                    REPLICAS="${API_REPLICAS:-2}"
                    echo ""
                    echo "Levantando backend dinámicamente (${REPLICAS} instancias) y Nginx load balancer..."
                    ${COMPOSE_CMD} up -d --build --scale api=${REPLICAS} api nginx

                    echo ""
                    echo "Servicios activos tras el despliegue:"
                    ${COMPOSE_CMD} ps
                '''
            }
        }


        /*
         * ========================================================
         * 10. HEALTH CHECK
         * ========================================================
         */
        stage('Health Check') {

            when {

                anyOf {
                    branch 'main'
                    branch 'master'
                    branch 'develop'
                    expression {
                        def branch = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                        return branch.contains('main') || branch.contains('master') || branch.contains('develop') || branch == ''
                    }
                }
            }

            steps {

                echo '''
                ==========================================
                 10. HEALTH CHECK
                ==========================================
                '''

                sh '''
                    set -e

                    MAX_RETRIES=15
                    WAIT_SECONDS=4
                    HEALTH_OK=false

                    # Determinar URL objetivo (red interna Docker o localhost)
                    TARGET_URL="http://cine-nginx:80${APP_HEALTH_PATH}"
                    if curl --fail --silent --show-error --max-time 2 "http://127.0.0.1:${HTTP_PORT}${APP_HEALTH_PATH}" > /dev/null 2>&1; then
                        TARGET_URL="http://127.0.0.1:${HTTP_PORT}${APP_HEALTH_PATH}"
                    fi

                    echo "Comprobando disponibilidad a través del proxy reverso Nginx en: ${TARGET_URL}"

                    for i in $(seq 1 ${MAX_RETRIES}); do
                        echo "Intento ${i}/${MAX_RETRIES}: Consultando ${TARGET_URL}..."
                        if curl --fail --silent --show-error --max-time 5 "${TARGET_URL}" > /dev/null 2>&1 || \
                           curl --fail --silent --show-error --max-time 5 "http://127.0.0.1:${HTTP_PORT}${APP_HEALTH_PATH}" > /dev/null 2>&1 || \
                           curl --fail --silent --show-error --max-time 5 "http://cine-nginx:80${APP_HEALTH_PATH}" > /dev/null 2>&1; then
                            echo ""
                            echo "Servicio respondió exitosamente a través de Nginx (HTTP 200 OK)."
                            HEALTH_OK=true
                            break
                        fi
                        sleep ${WAIT_SECONDS}
                    done

                    if [ "${HEALTH_OK}" != "true" ]; then
                        echo ""
                        echo "ERROR: Health check falló tras $((MAX_RETRIES * WAIT_SECONDS)) segundos."
                        echo "Logs del backend y nginx:"
                        docker compose logs --tail=60 api nginx || docker-compose logs --tail=60 api nginx || true
                        exit 1
                    fi

                    echo ""
                    echo "=========================================="
                    echo " HEALTH CHECK OK"
                    echo "=========================================="
                '''
            }
        }
    }


    /*
     * ============================================================
     * POST PIPELINE ACTIONS
     * ============================================================
     */
    post {

        success {

            echo '''
==========================================
 PIPELINE EXITOSO - RIWI CINE BACKEND
==========================================

 Checkout Information  ✓
 Install Dependencies   ✓ (app/)
 Lint (ESLint)          ✓ (app/)
 Unit Tests (Vitest)    ✓ (app/)
 Coverage (LCOV)        ✓ (app/)
 Build (NestJS)         ✓ (app/)
 SonarQube Analysis     ✓ (SAST)
 Quality Gate           ✓ (Gate Passed)
 Docker Build           ✓ (app/Dockerfile)
 Deploy (Compose)       ✓ (api-1, api-2, Nginx)
 Health Check           ✓ (GET /health 200 OK)

Múltiples instancias de la API desplegadas
y balanceadas bajo Nginx con éxito.
==========================================
'''

            echo "Build #${BUILD_NUMBER}"
            echo "Imagen Docker : ${DOCKER_IMAGE}:latest"
            echo "Health Check  : http://localhost:${HTTP_PORT}${APP_HEALTH_PATH}"
        }

        failure {

            echo '''
==========================================
 PIPELINE FALLIDO
==========================================
Una de las etapas del pipeline falló.
Revisar la traza de ejecución en los logs de Jenkins.
==========================================
'''

            sh '''
                echo "Estado de los contenedores:"
                docker compose ps || docker-compose ps || true

                echo ""
                echo "Logs recientes de api-1, api-2 y nginx:"
                docker compose logs --tail=100 api-1 api-2 nginx || docker-compose logs --tail=100 api-1 api-2 nginx || true
            '''
        }

        always {

            echo ""
            echo "=========================================="
            echo "Pipeline finalizado para Build #${BUILD_NUMBER}"
            echo "=========================================="
        }
    }
}
