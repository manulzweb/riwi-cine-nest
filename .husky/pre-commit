#!/bin/sh

# 1. Proteger ramas principales (main y master)
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
  echo ""
  echo "======================================================================"
  echo " [ERROR] No se permiten commits directos en la rama '$CURRENT_BRANCH'."
  echo "======================================================================"
  echo " Por política de DevOps, la rama principal es desplegable e inmutable."
  echo " Debes trabajar en una rama de características (ej: feature/US-101-login)"
  echo " y enviar tus cambios mediante Pull Request."
  echo "======================================================================"
  echo ""
  exit 1
fi

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR/app" || exit 1

# 2. Validación de formato y sintaxis
echo "[pre-commit] Ejecutando verificación de código con ESLint en app/..."
npm run lint || exit 1

# 3. Validación de pruebas unitarias
echo "[pre-commit] Ejecutando pruebas unitarias con Vitest en app/..."
npm test || exit 1
